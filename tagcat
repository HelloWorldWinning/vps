#!/usr/bin/env bash
# tagcat — bundle files into a single tagged txt file.
# Usage:
#   tagcat                      # all regular files in cwd
#   tagcat a.md b.txt           # only these files
#   tagcat -o out.txt *.md      # custom output name
set -u

folder=$(basename "$(pwd)")
datetag=$(date '+%Y-%m-%d_%H-%M-%S_%p_%a')

# Default output name: bundle_{folder}_{date_time_tag}.txt
output="bundle_${folder}_${datetag}.txt"

if [ "${1:-}" = "-o" ]; then
	if [ -z "${2:-}" ]; then
		echo "tagcat: -o needs a filename" >&2
		exit 2
	fi
	output="$2"
	shift 2
fi

# Collect files
files=()
if [ "$#" -eq 0 ]; then
	shopt -s nullglob 2>/dev/null || true
	for f in *; do
		[ -f "$f" ] || continue
		[ "$f" = "$output" ] && continue
		files+=("$f")
	done
else
	for f in "$@"; do
		files+=("$f")
	done
fi

echo "tagcat: output = $output"
echo "tagcat: found ${#files[@]} file(s) in $(pwd)"

if [ "${#files[@]}" -eq 0 ]; then
	echo "tagcat: no files to bundle" >&2
	exit 1
fi

# Truncate output file
: >"$output"

count=0
for file in "${files[@]}"; do
	if [ ! -f "$file" ]; then
		echo "tagcat: skipping '$file' (not a regular file)" >&2
		continue
	fi
	# Tag: original file name (basename), unchanged
	tag=$(basename "$file")
	# Absolute path for the cat header line
	abspath=$(realpath -- "$file" 2>/dev/null || readlink -f -- "$file" 2>/dev/null || printf '%s/%s' "$(pwd)" "$file")
	{
		printf '<%s>\n' "$tag"
		printf 'cat %s\n' "$abspath"
		cat -- "$file"
		printf '\n</%s>\n\n' "$tag"
	} >>"$output"
	echo "  + $file  ->  <$tag>"
	count=$((count + 1))
done

head_info="<docs_in_folder_${folder}>"
tail_info="</docs_in_folder_${folder}>"

# Prepend
printf '%s\n\n' "$head_info" | cat - "$output" >/tmp/tmpfile && mv /tmp/tmpfile "$output"
# Append
printf '%s\n' "$tail_info" >>"$output"

echo "tagcat: wrote $count file(s) to"

echo ""
echo -e "\033[1;31m$(pwd)/$output\033[0m"
tt $(pwd)/$output
