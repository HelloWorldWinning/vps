def get_token_encoders() -> Tuple[List[Tuple[str, object]], Optional[str]]:
    try:
        import tiktoken  # type: ignore
    except Exception as exc:
        return [], f"tiktoken unavailable: {type(exc).__name__}: {exc}"

    encoders: List[Tuple[str, object]] = []
    errors: List[str] = []

    try:
        encoders.append(("GPT", tiktoken.encoding_for_model("gpt-4o")))
    except Exception as exc:
        errors.append(f"GPT: {exc}")

    try:
        encoders.append(("Claude", tiktoken.get_encoding("o200k_base")))
    except Exception as exc:
        errors.append(f"Claude: {exc}")

    return encoders, "; ".join(errors) if errors else None


def token_count(encoder: object, text: str) -> int:
    return len(encoder.encode(text, disallowed_special=()))  # type: ignore[attr-defined]


def append_token_report(
    base_text: str,
    tree_text: str,
    python_text: str,
) -> Tuple[str, List[Tuple[str, int]]]:
    encoders, error = get_token_encoders()
    if not encoders:
        separator = "" if base_text.endswith("\n") else "\n"
        report = separator + "# tokens\n" + (error or "tiktoken unavailable") + "\n"
        return base_text + report, []

    tree_counts = {name: token_count(enc, tree_text) for name, enc in encoders}
    python_counts = {name: token_count(enc, python_text) for name, enc in encoders}

    report = ""
    separator = "" if base_text.endswith("\n") else "\n"
    report_base = base_text + separator
    final_text = report_base
    final_counts: Dict[str, int] = {}

    for _ in range(10):
        lines = ["# tokens"]
        for name, _enc in encoders:
            total = final_counts.get(
                name, token_count(dict(encoders)[name], final_text)
            )
            lines.append(
                f"{name}: total={total:,}  tree={tree_counts[name]:,}  python={python_counts[name]:,}"
            )
        if error:
            lines.append(error)
        new_report = "\n".join(lines) + "\n"
        candidate = report_base + new_report
        new_counts = {name: token_count(enc, candidate) for name, enc in encoders}
        if new_report == report and new_counts == final_counts:
            final_text = candidate
            break
        report = new_report
        final_counts = new_counts
        final_text = candidate

    return final_text, [(name, final_counts[name]) for name, _ in encoders]


