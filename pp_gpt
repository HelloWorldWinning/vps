def render_inputs(inputs: Sequence[InputSpec]) -> str:
    lines = ["# inputs"]
    for spec in inputs:
        lines.append(f"{level_name(spec.level)}  {spec.path}")
    return "\n".join(lines)


def render_tree(inputs: Sequence[InputSpec]) -> str:
    lines = ["# tree"]
    for index, root in enumerate(minimal_inventory_roots(inputs)):
        if index:
            lines.append("")
        lines.extend(render_tree_root(root))
    return "\n".join(lines)


def render_python_files(files: Sequence[PythonFile]) -> Tuple[str, List[str]]:
    lines = ["# python"]
    errors: List[str] = []

    for item in files:
        read = read_python_source(item.path)
        try:
            size = item.path.stat().st_size
        except OSError:
            size = len(read.source.encode("utf-8", errors="replace"))

        rendered, parse_error = render_python_level(read.source, item.path, item.level)
        lines.append("")
        lines.append(
            f"===== {level_name(item.level)}  {human_size(size)}  {line_count(read.source)}L  {item.path} ====="
        )
        if read.error:
            lines.append(f"# pp: source decoding fallback: {read.error}")
        lines.append(rendered)

        if parse_error:
            errors.append(f"{item.path}: {parse_error}")
        if read.error and not rendered:
            errors.append(f"{item.path}: {read.error}")

    return "\n".join(lines), errors


def render_warnings(warnings: Sequence[str], errors: Sequence[str]) -> str:
    all_items = list(warnings) + list(errors)
    if not all_items:
        return ""
    return "# warnings\n" + "\n".join(f"- {item}" for item in all_items)


def build_output(
    inputs: Sequence[InputSpec],
    files: Sequence[PythonFile],
    warnings: Sequence[str],
) -> Tuple[str, List[Tuple[str, int]]]:
    now = _dt.datetime.now().astimezone().isoformat(timespec="seconds")
    cwd = Path.cwd().resolve()

    input_text = render_inputs(inputs)
    tree_text = render_tree(inputs)
    python_text, parse_errors = render_python_files(files)
    warning_text = render_warnings(warnings, parse_errors)

    header = "\n".join(
        [
            "# pp summary",
            f"generated: {now}",
            f"cwd: {cwd}",
            f"python_files: {len(files)}",
        ]
    )

    parts = [header, input_text, tree_text, python_text]
    if warning_text:
        parts.append(warning_text)
    base = "\n\n".join(parts)
    if not base.endswith("\n"):
        base += "\n"
    return append_token_report(base, tree_text, python_text)


def print_extracted_files(files: Sequence[PythonFile]) -> None:
    print(Path.cwd().resolve())
    for item in files:
        try:
            size = item.path.stat().st_size
        except OSError:
            size = 0
        print(f"{human_size(size):>7}  {level_name(item.level):>4}  {item.path}")


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    inputs = parse_args(args)
    files, warnings = discover_python(inputs)

    if not files:
        print_extracted_files(files)
        for warning in warnings:
            print(f"pp: {warning}", file=sys.stderr)
        print("pp: no Python files to extract", file=sys.stderr)
        return 1

    output_path = make_output_path(inputs, Path.cwd().resolve())
    text, token_counts = build_output(inputs, files, warnings)
    output_path.write_text(text, encoding="utf-8")

    print_extracted_files(files)
    print(f"\nwritten: {output_path}")
    for name, count in token_counts:
        print(f"tokens {name}: {count:,}")
    if not token_counts:
        print(
            "tokens: tiktoken unavailable; install with: python3 -m pip install tiktoken"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
